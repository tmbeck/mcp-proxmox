# Proxmox API configuration
# Copy this to `.env` and set your values
PROXMOX_API_URL="https://proxmox.example.com:8006"
PROXMOX_TOKEN_ID="root@pam!mcp-proxmox"
PROXMOX_TOKEN_SECRET="<secret>"
PROXMOX_VERIFY="true"
PROXMOX_DEFAULT_NODE="pve"
PROXMOX_DEFAULT_STORAGE="local-lvm"
PROXMOX_DEFAULT_BRIDGE="vmbr0"

# Outbound network policy (strict by default)
# - only private/local hosts are allowed unless explicitly allowlisted
# - comma-separated list of public hosts or URLs to permit
PROXMOX_ALLOWED_URLS=""

# External third-party integrations (Slack/Teams/PagerDuty/Jira/webhooks)
# Disabled by default. Set to "true" only when needed.
PROXMOX_ENABLE_EXTERNAL_INTEGRATIONS="false"
